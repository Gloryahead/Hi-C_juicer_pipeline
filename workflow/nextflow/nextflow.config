// Nextflow skeleton for this pipeline's core stages (QC/trim -> Juicer ->
// inter_30.hic). This repo's maintained, complete implementation is the
// Snakemake DAG in workflow/Snakefile + workflow/rules/*.smk — this file
// exists so the project can switch managers without a rewrite, per the
// team's "either manager, same container strategy" convention. Downstream
// TAD/loop/compartment analysis (workflow/rules/03_downstream_analysis.smk)
// is NOT reimplemented here yet; port it the same way if you adopt Nextflow
// as primary.

params {
    outdir              = "results"
    samplesheet         = "../../config/samples.tsv"
    genome_fasta        = "/xdisk/haining/maarowosegbe/Hi-C_juicer_pipeline/ref/hg38.fa"
    chrom_sizes         = "/xdisk/haining/maarowosegbe/Hi-C_juicer_pipeline/ref/hg38.chrom.sizes"
    restriction_sites   = "/xdisk/haining/maarowosegbe/Hi-C_juicer_pipeline/ref/hg38_MboI.txt"
    restriction_enzyme  = "MboI"
    genome_id           = "hg38"
    juicer_dir          = "/xdisk/haining/maarowosegbe/Hi-C_juicer_pipeline/tools/juicer"
    trim_quality        = 20
    trim_min_length     = 20
    juicer_threads      = 16
}

singularity {
    enabled    = true
    autoMounts = true
    runOptions = "--bind /xdisk,/groups"
}

process {
    container = "file://../../containers/hic_juicer.sif"

    withName: 'FASTQC_RAW|TRIM_GALORE' {
        cpus   = 4
        memory = '8 GB'
        time   = '2h'
    }
    withName: 'JUICER_CORE' {
        cpus   = params.juicer_threads
        memory = '128 GB'
        time   = '48h'
    }
}

profiles {
    slurm {
        process.executor     = 'slurm'
        process.queue        = 'standard'
        process.clusterOptions = '--account=haining'
    }
}
